(* ABOP Fig 3.14: development of Lychnis coronaria, rose campion (book p. 84), after
   Robinson's analysis. A double cyme: each apex makes a flower and two lateral apices, in
   states A(0) and A(4), so one needs eight steps to flower again and the other four.
   The figure shows three stages; this file renders the largest one: step 28 has about as
   many buds, open flowers and fruits as the figure's middle plant (13, 8 and 12).
   Upgraded in v0.3 to use original bicubic surfaces (`surfaces/leaf.s`, `surfaces/bud.s`,
   `surfaces/flower5.s`). In `p1`, `~` before `K(0)` is moved into the `K(t) as` RubberPlant
   interpretation rules so the bud, open-flower, and fruit stages can switch surface and color.
   `'(1)` green, `L as`, `K as`, and `width = 3` are RubberPlant additions.
*)
settings { derivations = 28; width = 3; }

include L = "surfaces/leaf.s";
include Bud = "surfaces/bud.s";
include Flower = "surfaces/flower5.s";

axiom: '(1) A(7);
A(t) :
    when t == 7 -> F I(20) [ &(60) ~L(0) ] /(90) [ &(45) A(0) ] /(90)
                   [ &(60) ~L(0) ] /(90) [ &(45) A(4) ] F I(10) K(0)
    when t < 7  -> A(t+1);
I(t) : when t > 0 -> F F I(t-1);
L(t) -> L(t+1);
K(t) -> K(t+1);

(* Surface interpretations by organ age (RubberPlant additions). *)
L(t) as L(0.6 * min(t + 1, 6), 1.45 * min(t + 1, 6), 0.85 * min(t + 1, 6));
(* Flower stages: green bud (t < 4), 5-petal purple flower (4 <= t < 8), brown fruit capsule. *)
K(t) :
    when t < 4 as [ '(1) ~Bud(2.8) ]
    when t < 8 as [ '(6) ~Flower(6.2) ]
    else       as [ '(2) ~Bud(3.2) ];
