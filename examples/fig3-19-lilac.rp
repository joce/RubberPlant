(* ABOP Fig 3.19: lilac inflorescence (book p. 92); Fig 3.20b shows its skeleton.
   Each axis grows subapically; the 90 degree roll at every node gives a decussate pattern,
   with consecutive pairs of branches in perpendicular planes.
   Upgraded in v0.3: `~K` uses the original 4-petal cross floret `surfaces/lilac.s`,
   scaled via `K as K(0.95)`. Stem `'(1)` green, floret `'(6)` purple, `width = 3`,
   and `K as` are RubberPlant additions.
*)
settings { derivations = 10; angle = 60; width = 3; }

include K = "surfaces/lilac.s";

axiom: '(1) A '(6) ~K;
A -> [ - / '(6) ~K ] [ + / '(6) ~K ] I(0) /(90) A;
I(t) :
    when t != 2 -> F I(t+1)
    when t == 2 -> I(t+1) [ - F F A ] [ + F F A ];

K as K(0.95);
