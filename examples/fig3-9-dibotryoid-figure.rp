(* ABOP Fig 3.9: an acropetal flowering sequence in an open dibotryoid (book p. 79), reconstructed.
   RubberPlant reconstruction of the model that drew the figure, read off the figure's vector
   drawing in the book's PDF; companion to fig3-9-dibotryoid.rp, which keeps L-system 3.1
   (book p. 77) as printed. With these rules every stage of the figure (15, 18, 21, 24, 27, 30, 33) has the same number of internodes,
   black internodes and flowers, on every axis, as the figure.

   Same as L-system 3.1, except (all RubberPlant reconstruction):
   - numbering: the axiom's apex starts at a(2, 0) and d = 14, so the caption's derivation
     lengths are the step numbers;
   - branches: a branch makes its first internode 2 steps after it appears, its second one step
     later, then one every n steps (b's second parameter marks that first cycle);
   - flowering: when the signal reaches the internode below an apex, the apex (F) still makes its
     next regular internode, then stops growing; v + 2 steps after the signal's arrival it bears a
     flower at its tip (the main apex: u + 2 steps, and a short lateral X instead), and from the
     next step on it makes one flowering internode I(l) with a flower per step. A lateral apex
     reacts only once it has an internode of its own;
   - a new internode next to one the signal has passed is born with the signal (i == j);
   - geometry: internodes carry a length l and a growth factor g: main-axis internodes have length 1
     and don't grow; branch and flowering internodes start at 0.5 and grow 3% per step (as measured
     on the figure); every node bears a leaf; X grows 10% per step.
*)

settings { derivations = 33; }   (* the figure's last stage *)

let d = 14;   (* delay for sending florigen (figure numbering) *)
let e = 3;    (* delay for creating branches *)
let m = 2;    (* plastochron, main axis *)
let n = 3;    (* plastochron, lateral axis *)
let u = 1;    (* signal delay, main axis *)
let v = 1;    (* signal delay, lateral axis *)

(* For each predecessor, context-sensitive productions come first, so the file derives the same
   under ABOP 1.8's precedence (RubberPlant) and under cpfg's source order. *)
ignore: +;    (* keeps the branches' +(45) out of context matching *)
axiom: /(180) S(0) a(2, 0);   (* /(180): lowest branch on the right, as in the figure *)

(* signal: p6-p9 as printed, plus growth of l *)
S(t) -> S(t+1);
S(t) < I(i, j, l, g) : when t == d -> I(1, j, l*g, g);
I(i, j, _, _) < I(k, o, l, g) : when i == j && k == 0 -> I(1, o, l*g, g);
I(i, j, l, g) :
    when 0 < i && i < j -> I(i+1, j, l*g, g)
    else                -> I(i, j, l*g, g);
I(l) -> I(l*1.03);    (* flowering internode (the book's bare I) *)
X(l) -> X(l*1.1);

(* main apex *)
I(i, j, _, _) < a(t, c) :
    when i > 0 && t == m -> I(i == j, u, 1, 1) Fa(m, 1, 1)
    when i > 0           -> Fa(t+1, 1, 0)
    when t < m           -> a(t+1, c)
    when c < e           -> I(i == j, u, 1, 1) [ L ] a(1, c+1)
    else                 -> I(i == j, u, 1, 1) [ L ] [ +(45) b(n-1, 1) ] a(1, c);
a(t, c) :
    when t < m -> a(t+1, c)
    when c < e -> I(0, u, 1, 1) [ L ] a(1, c+1)
    else       -> I(0, u, 1, 1) [ L ] [ +(45) b(n-1, 1) ] a(1, c);

(* flowering main apex Fa(t, w, k): t plastochron count, w steps since the signal, k last internode made *)
I(i, j, _, _) < Fa(t, w, k) : when k == 0 && t == m -> I(i == j, u, 1, 1) Fa(m, w+1, 1);
Fa(t, w, k) :
    when k == 0 && t == m     -> I(0, u, 1, 1) Fa(m, w+1, 1)
    when k == 1 && w == 1 + u -> [ +(45) X(0.48) ] Fa(t, w+1, 1)
    when k == 1 && w >= 2 + u -> I(0.5) [ L ] [ K ] Fa(t, w+1, 1)
    else                      -> Fa(min(t+1, m), w+1, k);

(* lateral apex b(t, fc): fc = 1 until its first internode *)
I(i, j, _, _) < b(t, fc) :
    when i > 0 && fc == 0 && t == n -> I(i == j, v, 0.5, 1.03) [ L ] Fb(n, 1, 1)
    when i > 0 && fc == 0           -> Fb(t+1, 1, 0)
    when t < n                     -> b(t+1, fc)
    else                           -> I(i == j, v, 0.5, 1.03) [ L ] b(fc*n + 1 - fc, 0);
b(t, fc) :
    when t < n -> b(t+1, fc)
    else       -> I(0, v, 0.5, 1.03) [ L ] b(fc*n + 1 - fc, 0);

(* flowering lateral apex Fb(t, w, k) *)
I(i, j, _, _) < Fb(t, w, k) : when k == 0 && t == n -> I(i == j, v, 0.5, 1.03) [ L ] Fb(n, w+1, 1);
Fb(t, w, k) :
    when k == 0 && t == n     -> I(0, v, 0.5, 1.03) [ L ] Fb(n, w+1, 1)
    when k == 1 && w == 1 + v -> [ K ] Fb(t, w+1, 1)
    when k == 1 && w >= 2 + v -> I(0.5) [ L ] [ K ] Fb(t, w+1, 1)
    else                      -> Fb(min(t+1, n), w+1, k);

(* Appearance (RubberPlant completion, as in the figure): internodes black and thick once the
   signal has passed, thin and green before (the figure's grey; the palette has none); leaves are
   small cups, flowers dots on short stalks, apices arrows. *)
I(i, _, l, _) :
    when i > 0 as '(0) !(3) F(l) /(180)
    else       as '(1) !(1) F(l) /(180);
I(l) as '(0) !(3) F(l) /(180);
X(l) as [ '(1) !(1) F(l) ];
(* A leaf: a small cup straddling the axis at its node. *)
L as [ '(1) !(1) [ +(90) F(0.09) -(12) F(0.09) -(12) F(0.09) -(12) F(0.09) ]
                 [ -(90) F(0.09) +(12) F(0.09) +(12) F(0.09) +(12) F(0.09) ] ];
K as [ '(1) !(1) +(45) F(0.5) '(0) { . +(90) f(0.07) -(45) f(0.1) -(45) f(0.1) -(45) f(0.1)
                                     -(45) f(0.1) -(45) f(0.1) -(45) f(0.1) -(45) f(0.1) } ];
a(_, _) as [ '(0) !(3) F(0.4) { . +(155) f(0.3) +(115) f(0.2536) } ];
b(_, _) as [ '(0) !(3) F(0.4) { . +(155) f(0.3) +(115) f(0.2536) } ];
Fa(_, _, _) as [ '(0) !(3) F(0.4) { . +(155) f(0.3) +(115) f(0.2536) } ];
Fb(_, _, _) as [ '(0) !(3) F(0.4) { . +(155) f(0.3) +(115) f(0.2536) } ];
