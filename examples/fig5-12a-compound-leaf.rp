(* ABOP Fig 5.12a: compound leaf with alternating branching patterns
   (Table 5.3 row a, book p. 130).
   `angle = 45`, `'(1)` green color, and `width = 3` are RubberPlant additions.
*)
settings { derivations = 20; angle = 45; width = 3; }

let D = 1;     (* apical delay *)
let R = 1.36;  (* internode elongation rate *)

axiom: '(1) A(0);
A(d) :
    when d > 0  -> A(d - 1)
    when d == 0 -> F(1) [ + A(D) ] F(1) B(0);
B(d) :
    when d > 0  -> B(d - 1)
    when d == 0 -> F(1) [ - B(D) ] F(1) A(0);
F(a) -> F(a * R);
