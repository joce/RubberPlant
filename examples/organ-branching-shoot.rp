(* Pure-.rp Generalized Cylinder organ (v0.3): tapered branching woody stem with
   forked GC branch continuation and smooth multi-section UCup leaves. *)
settings {
  derivations = 3;
  angle = 28;
  width_scale = 1;
}

let w0 = 0.28;

axiom: '(2) ContourSides(8) ContourCircle !(w0) StartGC S(w0, 2.0) EndGC;

S(w, len) ->
  !(w) F(len * 0.55)
  [ /(137.5) + !(w * 0.7) S(w * 0.7, len * 0.72) ]
  [ /(275) + EndGC Leaf ]
  !(w * 0.85) F(len * 0.45)
  [ /(45) - EndGC Leaf ]
  !(w * 0.72) S(w * 0.72, len * 0.78);

Leaf as
  '(1) ContourCup(0.15) !(0.12) StartGC
  &(8) ContourCup(0.35) !(0.42) F(0.35)
  &(8) ContourCup(0.45) !(0.65) F(0.38)
  &(8) ContourCup(0.35) !(0.52) F(0.35)
  &(8) ContourCup(0.1) !(0) F(0.28)
  EndGC;
