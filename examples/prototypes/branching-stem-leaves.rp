(* Provisional organ probe (BP.3 / 3A): Tapered branching woody stem with attached leaves.
   Demonstrates automatic forked GC continuation for branches and explicit UCup leaves. *)
settings {
  derivations = 3;
  angle = 28;
  width_scale = 1;
}

let w0 = 0.28;

axiom: '(2) ContourSides(8) ContourCircle !(w0) StartGC S(w0, 2.0) EndGC;

S(w, len) ->
  !(w) F(len * 0.55)
  [ /(137.5) + !(w * 0.7) S(w * 0.7, len * 0.72) ]
  [ /(275) + EndGC Leaf ]
  !(w * 0.85) F(len * 0.45)
  [ /(45) - EndGC Leaf ]
  !(w * 0.72) S(w * 0.72, len * 0.78);

Leaf as
  '(1) ContourCup(0.45) !(0.15) StartGC
  &(10) !(0.55) F(0.45)
  &(10) !(0.65) F(0.45)
  &(10) !(0) F(0.4)
  EndGC;
