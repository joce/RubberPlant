(* Provisional organ probe (BP.3 / 3A): Compound pinnate frond.
   Circular rachis with opposite flat leaflets branching at each node. *)
settings {
  derivations = 7;
  width_scale = 1;
}

let pairs = 6;
let node_len = 0.9;
let rachis_w = 0.14;

axiom: '(1) ContourSides(8) ContourCircle !(rachis_w) StartGC R(0);

R(k) :
  when k < pairs ->
    &(4)
    !(rachis_w * (1 - 0.6 * k / pairs))
    F(node_len)
    [ +(58) /(15) EndGC ContourFlat !(0) StartGC Leaf(1.8 * (1 - 0.55 * k / pairs), 0.55 * (1 - 0.45 * k / pairs)) EndGC ]
    [ -(58) \(15) EndGC ContourFlat !(0) StartGC Leaf(1.8 * (1 - 0.55 * k / pairs), 0.55 * (1 - 0.45 * k / pairs)) EndGC ]
    R(k + 1)
  else ->
    EndGC ContourFlat !(0) StartGC Leaf(1.4, 0.42) EndGC;

Leaf(len, wid) as
  !(wid * 0.5) F(len * 0.25)
  &(5) !(wid) F(len * 0.35)
  &(5) !(wid * 0.6) F(len * 0.25)
  !(0) F(len * 0.15);
