(* ABOP Fig 1.27: stochastic plant. The seed is a run parameter, not part of
   the file: render with `--seed 1` for the plant in the tests' golden image,
   and change it for a different plant. *)
settings { derivations = 5; angle = 25.7; }

axiom: F;
F :
    weight .33 -> F[+F]F[-F]F
    weight .33 -> F[+F]F
    weight .34 -> F[-F]F;
