    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Palette.fs" />
    <Compile Include="Svg.fs" />
    <Compile Include="Mesh.fs" />
    <Compile Include="Obj.fs" />
    <Compile Include="Gltf.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RubberPlant.Core\RubberPlant.Core.fsproj" />
  </ItemGroup>

</Project>
