<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rubberplant</AssemblyName>
    <!-- `dotnet publish -r <rid>` builds a native executable: about 35 ms a run instead of 200,
         most of which is JIT compilation. Build and test still use the normal JIT build. -->
    <PublishAot>true</PublishAot>
    <!-- FSharp.Core and FParsec aren't annotated for AOT, so the AOT compiler sums up their
         warnings as IL2104 and IL3053. Our own assemblies are IsAotCompatible: their warnings
         are reported one by one and still fail the build. The goldens check the AOT output. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Output.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RubberPlant.Core\RubberPlant.Core.fsproj" />
    <ProjectReference Include="..\RubberPlant.Backends\RubberPlant.Backends.fsproj" />
  </ItemGroup>

</Project>
