<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The CLI is published with Native AOT: report this assembly's AOT warnings one by one,
         and forbid %A and the reflection-based ToString of records and unions. -->
    <IsAotCompatible>true</IsAotCompatible>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Unicode.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Builtins.fs" />
    <Compile Include="LString.fs" />
    <Compile Include="Geometry.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Eval.fs" />
    <Compile Include="Checker.fs" />
    <Compile Include="Rng.fs" />
    <Compile Include="Derivation.fs" />
    <Compile Include="Turtle.fs" />
    <Compile Include="Pipeline.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" />
  </ItemGroup>

</Project>
